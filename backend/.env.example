# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=3000
# Development LAN only; server ignores HOST when NODE_ENV=production.
HOST=0.0.0.0


# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# For LAN testing, replace 127.0.0.1 with this computer's LAN IPv4.
CLIENT_ORIGIN=http://127.0.0.1:5500

# Optional override; by default links use CLIENT_ORIGIN/account.html.
# The Auth API appends the one-time token as ?token=...
EMAIL_VERIFICATION_URL=


# ==========================================
# SMTP CONFIGURATION (verification email)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail App Password (16 letters; spaces between groups are accepted).
SMTP_PASSWORD=
MAIL_FROM=


# ==========================================
# MYSQL DATABASE CONFIGURATION
# ==========================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goc_desk
DB_USER=root
DB_PASSWORD=

# Maximum number of MySQL connections in the pool
DB_CONNECTION_LIMIT=10
